function b_plane = cutVolumeBorder(data,cut_grid,M,output_points)


% cutVolumeBorder cut a slice from the data and find the border of the cut 
% data_out.x, data_out.y, data_out.value is the output slice.
% b_list is the boundary polygon (5-by-2) in the plane coordination
% b_list1 is the boundary polygon (5-by-3) in the volume coordination
% The slice is specified by the initial grid (cut_grid.x,cut_grid.y) which
% is transformed by M.
% M is the tranform from slice coordination to volume coordination.
% The initial plane is assumed to be perpendicular to y axis.

% Down sample grid to make it faster
%% Rotate slice
% tic
% Create the grid
[xx0,zz0] = ndgrid(cut_grid.x(1:2:end),cut_grid.y(1:2:end));
yy0 = zeros(size(xx0));
pts0 = [xx0(:),yy0(:),zz0(:),ones(size(yy0(:)))]';

ptsSurf = [output_points(:,1),output_points(:,2),output_points(:,3),ones(size(output_points,1),1)]';
% Transformation
pts1 = M*pts0;
pts1Surf = M*ptsSurf;
xx1 = pts1(1,:);
yy1 = pts1(2,:);
zz1 = pts1(3,:);
% toc
% Interp and get the data
% tic 
Inpts = xx1>= min(data.x) & xx1<= max(data.x) &...
        zz1>= min(data.z) & zz1<= max(data.z) &...
        yy1>= min(data.y) & yy1<= max(data.y);
% toc
% tic
X0 = xx0(Inpts);
Z0 = zz0(Inpts);

b_plane = [X0',Z0'];


end


figure
scatter3(pts1(1,:),pts1(2,:),pts1(3,:))
hold on
scatter3(pts1Surf(1,:),pts1Surf(2,:),pts1Surf(3,:))
